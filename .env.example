# Copy to .env and adjust. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="mysql://doodi:doodi_dev_password@localhost:3307/doodi"
# Used only by `prisma migrate dev`
SHADOW_DATABASE_URL="mysql://doodi:doodi_dev_password@localhost:3307/doodi_shadow"
# Used only by `npm test` (a separate database that tests wipe!)
TEST_DATABASE_URL="mysql://doodi:doodi_dev_password@localhost:3307/doodi_test"

# --- App ---
# Public origin of the site. Used by the CSRF origin check when the app runs behind a proxy.
# Optional in development (the request's own origin is always accepted).
APP_ORIGIN="http://localhost:3000"

# --- TMDB (optional; the site works fully without it) ---
# Create a free account at https://www.themoviedb.org/settings/api and copy the
# "API Read Access Token" (the long JWT-looking one, NOT the short API key).
TMDB_API_READ_ACCESS_TOKEN=

DATABASE_CA="" # PEM of provider CA, only for hosts with a private CA (e.g. Aiven)
